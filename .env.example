# Copie para ".env.local" (no computador) ou cadastre na Vercel em
# Settings > Environment Variables. Valores em Supabase > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave secreta. Usada só no servidor para criar e desativar usuários.
# NUNCA coloque NEXT_PUBLIC_ na frente dela.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Código para criar o primeiro administrador em /primeiro-acesso.
# Escolha algo difícil de adivinhar. Depois de criar o admin pode apagar.
INITIAL_SETUP_CODE=troque-por-um-codigo-secreto

# Nome do sistema exibido nas telas (opcional).
NEXT_PUBLIC_APP_NAME=Acampa
